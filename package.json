{
  "devDependencies": {
    "husky": "^8.0.0",
    "lint-staged": "^16.1.6",
    "msw": "^2.11.3"
  },
  "scripts": {
    "prepare": "husky install"
  },
  "lint-staged": {
    "backend/**/*.{js,ts}": [
      "cd backend && npm run lint:fix",
      "cd backend && npm run format"
    ],
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "npm run lint:fix --prefix frontend",
      "npm run format --prefix frontend"
    ]
  }
}
